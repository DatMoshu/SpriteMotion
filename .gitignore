# evidence-central:begin
# Generated evidence belongs in D:/_agentShared/runs; gitignore has no size filter.
*.mp4
*.webm
*.png
*.jpg
*.jpeg
*.gif
# Explicit product asset/fixture allowlist (existing privacy ignores still apply).
!**/assets/**/*.png
!**/assets/**/*.jpg
!**/assets/**/*.jpeg
!**/assets/**/*.gif
!**/Assets/**/*.png
!**/Assets/**/*.jpg
!**/Assets/**/*.jpeg
!**/Assets/**/*.gif
!**/art/**/*.png
!**/textures/**/*.png
!**/icons/**/*.png
!**/fixtures/**/*.png
!**/fixtures/**/*.jpg
!**/fixtures/**/*.gif
# evidence-central:end

# Local art, models, scenes and renders never leave the workspace.
/workspace/*
!/workspace/README.md

# Generated packages, portable builds and their node_modules.
/outputs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
.pytest_cache/
/.venvs/
/.venv*/

# Godot
.godot/
*.import
/tools/sprite-pose-editor/tests/output/
/tools/godot/*.exe
/tools/godot/*.zip
/tools/godot/Godot_v*
/tools/godot/Godot.app/

# Blender
*.blend1
*.blend2

# Editor autosave / backup artefacts
*.autosave.json
*.bak
*.tmp

# Test output
/tests/output/
/tools/blender-runtime/
launchers/_shared/config.local.sh

# Browser automation scratch
/.playwright-mcp/
