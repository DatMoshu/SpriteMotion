{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spritemotion.local/schemas/equipment-slots.schema.json",
  "title": "SpriteMotion equipment slots of a game",
  "description": "The equipment layers a game's characters can wear or hold, and which rig bones and body regions each covers. Asset packs map their parts onto these slots.",
  "type": "object",
  "required": ["schema", "schema_version", "game", "layers"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "spritemotion.equipment-slots" },
    "schema_version": { "const": 1 },
    "game": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "target_rig": { "type": "string", "description": "Rig whose bone names appear in rig_bones." },
    "description": { "type": "string" },
    "regions": { "type": "array", "items": { "type": "string" } },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "animated"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer", "minimum": 0 },
          "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
          "kind": { "enum": ["held", "worn", "body", "jewelry", "container", "internal"] },
          "animated": { "type": "boolean", "description": "Has per-action body animations (false: paperdoll only)." },
          "studio_part": { "type": "string", "description": "Fit template used by the content studio." },
          "rig_bones": { "type": "array", "items": { "type": "string" } },
          "regions": { "type": "array", "items": { "type": "string" } },
          "examples": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
