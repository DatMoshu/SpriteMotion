{
 "schema": "spritemotion.equipment-slots",
 "schema_version": 1,
 "game": "ultima-online",
 "target_rig": "uo-model3d-v13",
 "description": "Classic UO equipment layers (the Layer enum shared by the client and ServUO/ModernUO). One item per layer per mobile. 'animated' layers have per-action body animations; the others only show on the paperdoll. 'studio_part' is the tools/uo-content fit template; 'rig_bones' are the canonical-rig bones an item on this layer is fitted to; 'regions' are the body-400 region-mask labels it covers.",
 "regions": ["head", "neck", "torso", "upper_arms", "forearms", "hands", "hips", "thighs", "shins", "feet"],
 "layers": [
  {"id": 1,  "name": "OneHanded",   "kind": "held", "animated": true,  "studio_part": "weapon", "rig_bones": ["hand.R"], "regions": ["hands"], "examples": ["swords", "maces", "one-handed axes", "staves held in one hand"]},
  {"id": 2,  "name": "TwoHanded",   "kind": "held", "animated": true,  "studio_part": "shield", "rig_bones": ["shield.L", "hand.L"], "regions": ["hands", "forearms"], "examples": ["shields", "bows", "crossbows", "two-handed weapons"], "notes": "Shields and two-handed weapons share this layer, so a mobile can never hold both."},
  {"id": 3,  "name": "Shoes",       "kind": "worn", "animated": true,  "studio_part": "boots", "rig_bones": ["foot.L", "foot.R"], "regions": ["feet"], "examples": ["boots", "sandals", "shoes"]},
  {"id": 4,  "name": "Pants",       "kind": "worn", "animated": true,  "studio_part": "legs", "rig_bones": ["pelvis", "thigh.L", "thigh.R", "shin.L", "shin.R"], "regions": ["hips", "thighs", "shins"], "examples": ["long pants", "short pants"]},
  {"id": 5,  "name": "Shirt",       "kind": "worn", "animated": true,  "studio_part": "chest", "rig_bones": ["spine", "chest", "upper_arm.L", "upper_arm.R"], "regions": ["torso", "upper_arms"], "examples": ["shirts", "fancy shirts"]},
  {"id": 6,  "name": "Helm",        "kind": "worn", "animated": true,  "studio_part": "helm", "rig_bones": ["head"], "regions": ["head"], "examples": ["helmets", "hats", "bandanas"]},
  {"id": 7,  "name": "Gloves",      "kind": "worn", "animated": true,  "studio_part": "gloves", "rig_bones": ["hand.L", "hand.R"], "regions": ["hands"], "examples": ["gloves", "gauntlets"]},
  {"id": 8,  "name": "Ring",        "kind": "jewelry", "animated": false, "regions": [], "examples": ["rings"]},
  {"id": 9,  "name": "Talisman",    "kind": "jewelry", "animated": false, "regions": [], "examples": ["talismans"]},
  {"id": 10, "name": "Neck",        "kind": "worn", "animated": true,  "studio_part": "helm", "rig_bones": ["neck"], "regions": ["neck"], "examples": ["gorgets", "necklaces"], "notes": "Gorgets animate; most necklaces are paperdoll-only."},
  {"id": 11, "name": "Hair",        "kind": "body", "animated": true,  "studio_part": "helm", "rig_bones": ["head"], "regions": ["head"], "examples": ["hair styles"]},
  {"id": 12, "name": "Waist",       "kind": "worn", "animated": true,  "studio_part": "skirt", "rig_bones": ["pelvis"], "regions": ["hips"], "examples": ["half aprons", "belts"]},
  {"id": 13, "name": "InnerTorso",  "kind": "worn", "animated": true,  "studio_part": "chest", "rig_bones": ["spine", "chest"], "regions": ["torso"], "examples": ["chest armour", "bustiers"]},
  {"id": 14, "name": "Bracelet",    "kind": "jewelry", "animated": false, "regions": [], "examples": ["bracelets"]},
  {"id": 15, "name": "Face",        "kind": "worn", "animated": true,  "studio_part": "helm", "rig_bones": ["head"], "regions": ["head"], "examples": ["masks", "face paint items"], "notes": "Added in later clients; check the target client and server support it."},
  {"id": 16, "name": "FacialHair",  "kind": "body", "animated": true,  "studio_part": "helm", "rig_bones": ["head"], "regions": ["head"], "examples": ["beards", "moustaches"]},
  {"id": 17, "name": "MiddleTorso", "kind": "worn", "animated": true,  "studio_part": "chest", "rig_bones": ["spine", "chest", "pelvis"], "regions": ["torso", "hips"], "examples": ["tunics", "surcoats", "body sashes", "full aprons"]},
  {"id": 18, "name": "Earrings",    "kind": "jewelry", "animated": false, "regions": [], "examples": ["earrings"]},
  {"id": 19, "name": "Arms",        "kind": "worn", "animated": true,  "studio_part": "arms", "rig_bones": ["upper_arm.L", "upper_arm.R", "forearm.L", "forearm.R"], "regions": ["upper_arms", "forearms"], "examples": ["arm armour", "sleeves"]},
  {"id": 20, "name": "Cloak",       "kind": "worn", "animated": true,  "studio_part": "cloak", "rig_bones": ["chest", "pelvis", "thigh.L", "thigh.R"], "regions": ["torso", "hips", "thighs"], "examples": ["cloaks", "quivers"], "notes": "Quivers use this layer too, so a cloak and a quiver cannot be worn together."},
  {"id": 21, "name": "Backpack",    "kind": "container", "animated": true, "rig_bones": ["chest"], "regions": ["torso"], "examples": ["backpack"]},
  {"id": 22, "name": "OuterTorso",  "kind": "worn", "animated": true,  "studio_part": "robe", "rig_bones": ["chest", "pelvis", "thigh.L", "thigh.R"], "regions": ["torso", "hips", "thighs", "shins"], "examples": ["robes", "dresses"]},
  {"id": 23, "name": "OuterLegs",   "kind": "worn", "animated": true,  "studio_part": "skirt", "rig_bones": ["pelvis", "thigh.L", "thigh.R"], "regions": ["hips", "thighs"], "examples": ["skirts", "kilts"]},
  {"id": 24, "name": "InnerLegs",   "kind": "worn", "animated": true,  "studio_part": "legs", "rig_bones": ["pelvis", "thigh.L", "thigh.R", "shin.L", "shin.R"], "regions": ["hips", "thighs", "shins"], "examples": ["leg armour"]},
  {"id": 25, "name": "Mount",       "kind": "internal", "animated": false, "regions": [], "examples": ["the mount item of a ridden creature"]}
 ]
}
